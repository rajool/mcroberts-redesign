{#
/**
 * @file
 * A block: a plain wrapper with the module and plugin classes kept (block-{provider}, block-{plugin}); no
 * Bootstrap classes. Style plugin classes, never #block-* ids (they gain the theme prefix when the blocks are
 * copied at install).
 */
#}
{%
  set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes.addClass('block-title') }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
