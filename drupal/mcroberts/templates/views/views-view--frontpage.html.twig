{#
/**
 * @file
 * View frontpage (page_1, path /node = the front page): Latest News. The lead story, two cards and four rows
 * (newest first, the Striker Weekly posts kept for their own panel), the Striker Weekly beside them, News Archive.
 * One link per title (the live view nests <a> in <a>). The view's own header and footer words are the same.
 *
 * Variables: mcroberts_news (mcroberts_preprocess_views_view()).
 */
#}
{% import '@mcroberts/includes/macros.html.twig' as m %}
{% set n = mcroberts_news %}
{% set w = n.weeklies|first %}
<!-- content → view frontpage (Latest News, 10 rows); Striker Weekly from the newsletters feed -->
<section class="news" aria-labelledby="news-title"><div class="wrap"><div class="section-head"><div><p class="eyebrow">News</p><h2 id="news-title">Latest News</h2></div><a class="arrow-link" href="{{ n.archive }}"><span>News Archive</span>{{ m.icon('arrow') }}</a></div><div class="news-grid"><div class="news-main">
{%- if n.lead -%}<article class="story-feature"><div class="meta"><time datetime="{{ n.lead.date.iso }}">{{ n.lead.date.long }}</time></div><h3 id="feature-title"><a href="{{ n.lead.url }}">{{ n.lead.title }}</a></h3><p>{{ n.lead.teaser }}</p><a class="arrow-link" href="{{ n.lead.url }}"><span id="feature-more">{{ 'Read more'|t }}</span><span class="vh">: {{ n.lead.title }}</span>{{ m.icon('arrow') }}</a></article>{%- endif -%}
<ul class="story-cards">{% for x in n.cards %}<li class="story-card">{{ m.chip(x.date) }}<div><h3><a href="{{ x.url }}">{{ x.title }}</a></h3><p>{{ x.teaser }}</p></div></li>{% endfor %}</ul><ul class="story-list">{% for x in n.rows %}<li class="story"><time class="date" datetime="{{ x.date.iso }}"><span class="m">{{ x.date.m }}</span><span class="n">{{ x.date.n }}</span></time><div><h3><a href="{{ x.url }}">{{ x.title }}</a></h3></div></li>{% endfor %}</ul></div>
{%- if w -%}<aside class="news-side" aria-labelledby="weekly-title"><div class="weekly"><div class="weekly-plate"><span class="tag">Newsletters</span><h3 class="weekly-name" id="weekly-title">Striker Weekly</h3><span class="weekly-sub">a Week at a Glance for Parents</span></div><div class="weekly-issue"><time class="range" id="weekly-range" datetime="{{ w.date.iso }}">{{ w.range }}</time><p>{{ w.teaser }}</p><a class="btn btn-solid" href="{{ w.url }}"><span id="weekly-more">{{ 'Read more'|t }}</span><span class="vh">: Striker Weekly {{ w.range }}</span>{{ m.icon('arrow', 'icon icon-sm') }}</a></div><ul class="weekly-past">{% for x in n.weeklies|slice(1, 2) %}<li><a href="{{ x.url }}">{{ x.title }}{{ m.icon('arrow') }}</a></li>{% endfor %}</ul><div class="weekly-foot"><a class="arrow-link" href="{{ n.newsletters }}"><span>Newsletters</span>{{ m.icon('arrow') }}</a></div></div></aside>{%- endif -%}
</div></div></section>
