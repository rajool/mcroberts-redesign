{#
/**
 * @file
 * McRoberts: page.html.twig (overrides Bootstrap Barrio and the live rsd_sites_barrio page template).
 *
 * The region machine names are the live ones. Print order, as the static preview (build.py shell()):
 *   district strip + menu utility (region secondary_menu)
 *   header: top_header (site header view: the crest lockup), header_form tools (Translate, Accessibility
 *           Settings, Search), phone actions, primary_menu (mega menu)
 *   featured_top (news alerts band, printed only when the view has rows), highlighted (status messages)
 *   main#main-content: a node page this theme composes prints its node template (hero, section menu, rail);
 *           any other page (views, search, user pages) gets the same hero and grid around region content
 *   footer: footer_first (menu footer), footer_second (Social Media), footer_fifth, district logo, copyright,
 *           Accessibility Settings, the phone action bar
 *   the phone menu dialog and the Accessibility Settings dialog (region accessibility_dropdown) on every page.
 *
 * Variables beyond core: mcroberts (Site::chrome() + cur, drawer, footer_cols, action_dup), mcroberts_owned,
 * mcroberts_page (generic pages), set in mcroberts_preprocess_page().
 */
#}
{% import '@mcroberts/includes/macros.html.twig' as m %}
{% set c = mcroberts %}
<div class="page" id="page-wrapper">
{% include '@mcroberts/includes/utility-strip.html.twig' with {c: c, menu: page.secondary_menu|render} only %}
<header class="site-header" id="site-header" data-sticky-header><span class="sticky-sentinel" aria-hidden="true"></span>
<!-- region top_header (view site_header_content_block: crest, name) + header_form (Translate, Accessibility Settings, Search) -->
{% set top_header = page.top_header|render %}
{% set top_header_form = page.top_header_form|render %}
<div class="masthead"><div class="wrap">{% if top_header|striptags('<img>')|trim %}{{ top_header }}{% else %}<div class="region region-top-header">{% include '@mcroberts/includes/lockup.html.twig' with {c: c} only %}</div>{% endif %}{% if top_header_form|striptags('<img>')|trim %}{{ top_header_form }}{% endif %}<div class="mast-tools region region-header-form">{% include '@mcroberts/includes/translate.html.twig' with {c: c, uid: 'desktop', variant: 'desktop'} only %}{% include '@mcroberts/includes/a11y-button.html.twig' with {cls: 'tool-btn', label: true} only %}{% include '@mcroberts/includes/search-form.html.twig' with {action: c.search_action, uid: 'desktop'} only %}{{ page.header_form }}</div><div class="mobile-actions"><button class="icon-btn" type="button" aria-expanded="false" aria-controls="mobile-search" data-toggle-search>{{ m.icon('search') }}<span class="vh">Search</span></button>{% include '@mcroberts/includes/absent-pill.html.twig' with {c: c, cls: 'absent-pill tablet-absent'} only %}<button class="menu-btn" type="button" data-open-dialog="menu-drawer" commandfor="menu-drawer" command="show-modal" aria-haspopup="dialog" aria-expanded="false" aria-controls="menu-drawer">{{ m.icon('menu') }}<span class="txt">Menu</span></button></div></div></div>
<div class="mobile-search" id="mobile-search" hidden><div class="wrap">{% include '@mcroberts/includes/search-form.html.twig' with {action: c.search_action, uid: 'mobile'} only %}</div></div>
{{ page.primary_menu }}</header>
{{ page.featured_top }}
{{ page.highlighted }}
<!-- MAIN:START -->
<main id="main-content" class="region region-content" tabindex="-1">
{% block main %}
{% if mcroberts_owned %}
{{ page.content }}
{% else %}
{% set p = mcroberts_page %}
{% include '@mcroberts/includes/hero.html.twig' with {c: c, title: p.title, eyebrow: p.eyebrow, alias: '', compact: true, breadcrumb: page.breadcrumb, meta: null} only %}
<div class="page-body"><div class="wrap page-grid no-sidebar"><div class="page-content{{ p.hub ? ' is-hub' : '' }}{{ p.search ? ' search-page' : '' }}">{{ page.content }}{% if p.hub %}{% include '@mcroberts/includes/hub-sections.html.twig' with {hub: p.hub} only %}{% endif %}{% if p.search %}<section class="search-browse" aria-labelledby="sb-title"><h2 id="sb-title" class="eyebrow">Helpful Links</h2>{% include '@mcroberts/includes/hub-cards.html.twig' with {cards: p.tops, tag: 'h3', cls: ''} only %}</section>{% endif %}</div>{% include '@mcroberts/includes/rail.html.twig' with {c: c, r: p.rail} only %}</div></div>
{% endif %}
{% endblock %}
{{ page.featured_bottom_first }}{{ page.featured_bottom_second }}{{ page.featured_bottom_third }}
</main>
<!-- MAIN:END -->
{% include '@mcroberts/includes/footer.html.twig' with {c: c, menu: page.footer_first|render, cols: c.footer_cols, social: page.footer_second, fifth: page.footer_fifth, dup: c.action_dup} only %}
</div>
{% include '@mcroberts/includes/drawer.html.twig' with {c: c, tops: c.drawer} only %}
{% include '@mcroberts/includes/a11y-dialog.html.twig' with {region: page.accessibility_dropdown|render} only %}
