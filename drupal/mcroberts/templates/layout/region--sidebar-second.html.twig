{#
/**
 * @file
 * Region sidebar_second. On the front page it is the Helpful Links band: the Student Absent? note (sidebar_notes
 * block_2) leads, then School Calendar, Bell Schedule and Striker Weekly with their live sub-lines, then the
 * district quick links and home page buttons (each block prints its own tiles). Elsewhere a plain region.
 *
 * Variables: mcroberts_tasks (mcroberts_preprocess_region(), front page only).
 */
#}
{% if mcroberts_tasks %}
{% set t = mcroberts_tasks %}
<!-- Front page sidebar_second: sidebar_notes:block_2 (Student Absent?), district_quick_links, home_page_buttons -->
<section class="tasks region region-sidebar-second" aria-labelledby="tasks-title"><h2 class="eyebrow tasks-title" id="tasks-title">Helpful Links</h2><ul class="task-grid">{% for b in t.lead %}{{ b }}{% endfor %}{% include '@mcroberts/includes/day-tiles.html.twig' with {c: t.chrome, day: t.day, first: t.first, weekly: t.weekly, bell_title: t.bell_title} only %}{% for b in t.rest %}{{ b }}{% endfor %}</ul></section>
{% elseif content %}
<div{{ attributes.addClass('region', 'region-sidebar-second') }}>{{ content }}</div>
{% endif %}
