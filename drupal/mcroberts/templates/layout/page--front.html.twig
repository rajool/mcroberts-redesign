{#
/**
 * @file
 * McRoberts: the front page (the frontpage view at /node, page_1).
 *
 * The same chrome as page.html.twig; the main column re-composes the live front-page regions, so no block moves:
 *   hero          the site header data (name, slogan) over the header photo (an <img>; the id #header-img-area that
 *                 bg_image_formatter styles stays on the node hero only, where the opaque photo layer covers it)
 *   front-top     Today (bell schedule + rotation code of the school day, from calendar_event nodes and the
 *                 bell schedule) beside Helpful Links (region sidebar_second: the Student Absent? note, the
 *                 district quick links and home page buttons, with the day-dependent tiles)
 *   news          region content: view frontpage (Latest News) with the Striker Weekly
 *   events        region sidebar_first: view upcoming_events (block_1)
 *   hubs          menu hub-links, the <front> entry: the Parents and Students task lists
 *   about, strikers, contact   copy of the About Us, Mission Statement and Strikers Athletics pages and the
 *                 address block, as the preview shows them
 * js/today.js re-renders every today-dependent part from #today-data when the page is opened on a later day.
 */
#}
{% extends '@mcroberts/layout/page.html.twig' %}
{% block main %}
{% import '@mcroberts/includes/macros.html.twig' as m %}
{% set c = mcroberts %}
{% set f = mcroberts_front %}
{% set cc = c.contact %}
{% set slogan = c.motto|split('… ') %}
{{ attach_library('mcroberts/today') }}
<!-- region top_header: view site_header_content_block (name, slogan) over the header photo, here a real <img> so the browser finds it early. No #header-img-area: the header photo style bg_image_formatter attaches for that id would paint behind the text -->
<section class="hero"><div class="wrap"><div class="hero-text"><h1>{% if c.name_main %}<span class="h1-pre">{{ c.name_pre }}</span><span class="h1-main">{{ c.name_main }}</span><span class="h1-post">{{ c.name_post }}</span>{% else %}<span class="h1-main">{{ c.name }}</span>{% endif %}</h1><p class="slogan">{% if slogan|length == 2 %}{{ slogan[0] }}… <em>{{ slogan[1] }}</em>{% else %}{{ c.motto }}{% endif %}</p><p class="hero-lead">McRoberts Secondary is a dual-track school offering both English and French Immersion programs.</p></div><figure class="hero-media"><span class="arch-keyline" aria-hidden="true"></span><span class="arch-year" aria-hidden="true">1962</span><div class="arch"><img src="{{ c.header_img.src }}" alt="" width="{{ c.header_img.w }}" height="{{ c.header_img.h }}" fetchpriority="high" decoding="async"></div><figcaption class="arch-caption">{{ m.icon('pin') }}<span>{{ cc.address_line1 }}</span><span>{{ cc.line2 }}</span></figcaption></figure></div></section>
{% set tasks = page.sidebar_second|render %}
<div class="front-top"><div class="wrap front-top-grid">
{%- if f.day -%}
<!-- Today: view upcoming_events (date contextual filter = today → the rotation code) + custom block (timetable from the bell schedule); refreshed in the browser by js/today.js -->
<section class="today region region-sidebar-first" id="today" aria-labelledby="today-title"><div class="today-head"><p class="eyebrow{{ f.day.is_today ? '' : ' is-empty' }}" data-t="eyebrow">Today</p><h2 id="today-title"><a href="{{ c.paths.bell }}">Bell Schedule</a></h2><time class="today-date" datetime="{{ f.day.iso }}" data-t="date">{{ f.day.date }}</time><ul class="chips" data-t="chips">{% if f.day.rot %}<li class="chip">{{ f.day.rot }}</li>{% endif %}<li class="chip chip--forest">{{ f.day.code }}</li></ul></div>{% if f.first %}<a class="next" href="{{ f.first.url }}" data-t="next"><span class="lbl">Next</span><time datetime="{{ f.first.chip.iso }}">{{ f.first.chip.short }}</time><span class="t">{{ f.first.title }}</span>{{ m.icon('arrow') }}</a>{% endif %}<div class="today-absent"><span class="dot" aria-hidden="true">{{ m.icon('phone') }}</span><a class="lbl" href="{{ c.absent.url }}"><span>{{ c.absent.label }}</span>{{ m.icon('arrow') }}</a><a class="num" href="{{ cc.tel_ext }}">{{ cc.phone }} (Ext. 1)</a></div><ol class="blocks" data-t="blocks">{% for b in f.day.blocks %}<li style="--m:{{ b.m }}"{% if b.cls %} class="{{ b.cls }}"{% endif %}{% if b.blk %} data-blk="{{ b.blk }}"{% endif %}><b>{{ b.label }}</b><time>{{ b.range }}</time></li>{% endfor %}</ol><ol class="week" data-t="week">{% for w in f.day.week %}<li{% if w.cls %} class="{{ w.cls }}"{% endif %}{% if w.today %} aria-current="date"{% endif %}>{% if w.today %}<span class="tag-today">Today</span>{% endif %}<span class="d">{{ w.d }}</span><span class="n">{{ w.n }}</span><span class="c">{{ w.c }}</span></li>{% endfor %}</ol><div class="collab"><p class="collab-title">{{ f.day.collab_title }}</p><ol data-t="collab">{% for x in f.day.collab %}<li{% if x.cls %} class="{{ x.cls }}"{% endif %}>{% if x.past %}<s><time datetime="{{ x.iso }}">{{ x.label }}</time></s>{% else %}<time datetime="{{ x.iso }}">{{ x.label }}</time>{% endif %}</li>{% endfor %}</ol></div></section>
{%- endif -%}
{%- if tasks|striptags|trim -%}{{ tasks }}{%- else -%}
<!-- Front page sidebar_second (no blocks placed): the same Helpful Links from menu utility -->
<section class="tasks region region-sidebar-second" aria-labelledby="tasks-title"><h2 class="eyebrow tasks-title" id="tasks-title">{{ 'Helpful Links'|t }}</h2><ul class="task-grid"><li class="is-featured"><div class="task task--absent on-dark"><span class="task-ico" aria-hidden="true">{{ m.icon('phone') }}</span><span class="absent-body"><a class="absent-title" href="{{ c.absent.url }}"><span>{{ c.absent.label }}</span>{{ m.icon('arrow') }}</a><a class="absent-num" href="{{ cc.tel_ext }}">{{ cc.phone }} <span class="absent-ext">(Ext. 1)</span></a></span></div></li>{% include '@mcroberts/includes/day-tiles.html.twig' with {c: c, day: f.day, first: f.first, weekly: f.weekly, bell_title: f.bell_title} only %}{% for t in f.signin_tasks %}{% include '@mcroberts/includes/task-tile.html.twig' with {url: t.url, icon: t.icon, label: t.label, sub: t.sub, live: '', ext: true} only %}{% endfor %}</ul></section>
{%- endif -%}
</div></div>
{{ page.content }}
{{ page.sidebar_first }}
<!-- menu block "hub links" (design/ia.json hubs["/"]): the Parents and Students task lists -->
<div class="hubs"><div class="wrap hub-pair">{% for h in f.hub_band %}<section class="hub" aria-labelledby="{{ h.id }}"><div class="hub-head"><span class="hub-ico" aria-hidden="true">{{ m.icon(h.icon) }}</span><h2 id="{{ h.id }}"><a href="{{ h.url }}">{{ h.heading }}{{ m.icon('arrow') }}</a></h2></div><ul class="hub-links" style="--rows:{{ h.rows }}">{% for l in h.links %}<li><a href="{{ l.url }}"><span>{{ l.label }}</span>{{ l.http ? m.icon('ext', 'icon ext-mark') : m.icon('arrow') }}</a></li>{% endfor %}</ul></section>{% endfor %}</div></div>
<!-- Heritage: About Us copy (node /about-us) + Mission Statement (child page) -->
<section class="about" aria-labelledby="about-title"><div class="wrap"><div class="about-grid"><div class="about-text"><p class="eyebrow">About Us</p><h2 class="about-statement" id="about-title">McRoberts has a long and well-established tradition of <em>student achievement and academic excellence, athletics and community involvement.</em></h2><ul class="facts"><li><span class="fact-num">1962</span><p>The school first opened in November 1962</p></li><li><span class="fact-num">8–12</span><p>over 1000 students in Grades 8 to 12</p></li><li><span class="fact-num"><em>École</em></span><p>English and French Immersion programs</p></li></ul><div class="about-links"><a class="arrow-link" href="{{ f.about.about }}"><span>About Us</span>{{ m.icon('arrow') }}</a><a class="arrow-link" href="{{ f.about.staff }}"><span>Our Staff</span>{{ m.icon('arrow') }}</a><a class="arrow-link" href="{{ f.about.catchment }}"><span>Catchment</span>{{ m.icon('arrow') }}</a></div></div><figure class="about-media"><span class="arch-keyline" aria-hidden="true"></span><div class="arch"><img src="{{ f.building.src }}" alt="" width="{{ f.building.w }}" height="{{ f.building.h }}" loading="lazy" decoding="async"></div><figcaption>McRoberts is a bilingual school where staff, students, and parents learn together in an environment of trust, support, and mutual respect.</figcaption></figure></div><figure class="mission"><figcaption class="eyebrow" id="mission-title">Mission Statement</figcaption><blockquote><p>Our purpose is to enable all learners to develop their potential, prepare for the future, and achieve their dreams.</p></blockquote><a class="arrow-link" href="{{ f.about.mission }}"><span id="mission-more">{{ 'Read more'|t }}</span><span class="vh">: Mission Statement</span>{{ m.icon('arrow') }}</a></figure></div></section>
<!-- Extra-Curricular: nodes /extra-curricular/strikers-athletics (quote, provincial banners) and /club-directory -->
<section class="strikers on-dark" aria-labelledby="strikers-title"><p class="strikers-word" aria-hidden="true">Strikers</p><div class="wrap strikers-grid"><div class="strikers-logo"><img src="{{ f.strikers.src }}" alt="" width="{{ f.strikers.w }}" height="{{ f.strikers.h }}" loading="lazy" decoding="async"></div><div class="strikers-body"><p class="eyebrow">Strikers</p><h2 id="strikers-title">Extra-Curricular</h2><blockquote class="strikers-quote"><p>As a Striker, you are expected to be committed to practicing and playing hard while always representing our school with <em>pride, sportsmanship, and class.</em></p></blockquote><div class="strikers-links"><a class="strikers-cta" href="{{ f.about.strikers }}"><strong>Strikers Athletics</strong><span>Learn more about our different athletic teams</span>{{ m.icon('arrow') }}</a><a class="strikers-cta" href="{{ f.about.clubs }}"><strong>Club Directory</strong><span>Learn more about our student-led clubs</span>{{ m.icon('arrow') }}</a></div></div></div><div class="wrap banners-wrap"><p class="banners-cap">McRoberts has previously won provincial banners for field hockey, soccer, rugby, and curling.</p><ul class="banners" aria-hidden="true"><li><span>field hockey</span></li><li><span>soccer</span></li><li><span>rugby</span></li><li><span>curling</span></li></ul></div></section>
<!-- block_content address_block (footer_fourth), given room on the front page -->
<section class="contact" aria-labelledby="contact-title"><div class="wrap contact-grid"><div><h2 id="contact-title">Contact Us</h2><address class="contact-address"><a href="{{ cc.map_url }}">{{ m.icon('pin') }}<span>{{ cc.address_line1 }}<br>{{ cc.line2 }} <span class="nowrap">{{ cc.postal_code }}</span></span></a></address></div><ul class="contact-cards"><li><a href="{{ cc.tel }}"><span class="task-ico">{{ m.icon('phone') }}</span><span class="lbl">Telephone:</span><span class="val">{{ cc.phone_dots }}</span></a></li><li><a href="{{ cc.tel_ext }}"><span class="task-ico">{{ m.icon('clock') }}</span><span class="lbl">Early Warning:</span><span class="val">{{ cc.phone_dots }}<small>Ext. 1</small></span></a></li><li><a href="mailto:{{ cc.email }}"><span class="task-ico">{{ m.icon('mail') }}</span><span class="lbl">Email:</span><span class="val val--email">{{ cc.email }}</span></a></li></ul></div></section>
<script type="application/json" id="today-data">{{ f.json }}</script>
{% endblock %}
