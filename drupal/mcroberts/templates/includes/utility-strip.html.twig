<!-- District strip (hardcoded in page.html.twig) + menu utility (system_menu_block:utility, design/ia.json "utility"): Student Absent? and its number as one pill, the three sign-ins, Contact Us -->
<nav class="utility on-dark"><div class="wrap"><a class="district-link" href="{{ c.district.url }}"><img src="{{ c.district.logo.src }}" alt="{{ c.district.name }}" width="{{ c.district.logo.w }}" height="{{ c.district.logo.h }}"></a>{% if menu|striptags('<a>')|trim %}{{ menu }}{% else %}{% include '@mcroberts/includes/utility-menu.html.twig' with {c: c} only %}{% endif %}</div></nav>
