{#
/**
 * @file
 * Calendar event, full (node calendar_event, /2026/…): Event Date, that day's rotation code and timetable, the day
 * in the School Calendar, the next events, Subscribe to our calendar. Titles typed in capitals are shown in title
 * case (the words are unchanged); the U+FEFF marks of the live titles are removed.
 *
 * Variables: mcroberts (_mcroberts_node_variables()): event (Calendar::eventPage() + when), noschool,
 * noschool_tag, title, breadcrumb, rail, chrome.
 */
#}
{% import '@mcroberts/includes/macros.html.twig' as m %}
{% if mcroberts.page %}
{% set mc = mcroberts %}
{% set ev = mc.event %}
{{ attach_library('mcroberts/views') }}
{% include '@mcroberts/includes/hero.html.twig' with {c: mc.chrome, title: mc.title, eyebrow: mc.eyebrow, alias: '', compact: true, breadcrumb: mc.breadcrumb, meta: null} only %}
<div class="page-body"><div class="wrap page-grid no-sidebar"><article{{ attributes.addClass('page-content', 'event-page') }}>{{ title_prefix }}{{ title_suffix }}<!-- node calendar_event: field_event_date; the day from view calendar; timetable from the bell schedule block -->
<div class="event-when{{ mc.noschool ? ' is-noschool' : '' }}">{{ m.chip_lg(ev.chip) }}<div><h2>Event Date</h2><p><time datetime="{{ ev.chip.iso }}">{{ ev.when }}</time>{% if mc.noschool_tag %} <span class="tag-noschool">No School</span>{% endif %}</p><ul class="chips">{% if ev.rot %}<li class="chip">{{ ev.rot }}</li>{% endif %}{% if ev.code %}<li class="chip chip--forest">{{ ev.code }}</li>{% endif %}</ul></div></div>
{%- if ev.blocks -%}<section class="event-bell" aria-labelledby="ev-bell"><h2 id="ev-bell"><a href="{{ mc.chrome.paths.bell }}">Bell Schedule</a></h2><ol class="blocks">{% for b in ev.blocks %}<li style="--m:{{ b.m }}"{% if b.cls %} class="{{ b.cls }}"{% endif %}{% if b.blk %} data-blk="{{ b.blk }}"{% endif %}><b>{{ b.label }}</b><time>{{ b.range }}</time></li>{% endfor %}</ol></section>{%- endif -%}
<section class="event-day" aria-labelledby="ev-day"><h2 id="ev-day"><a href="{{ mc.chrome.paths.calendar }}#d-{{ ev.chip.iso }}">School Calendar</a></h2><ol class="agenda">{% include '@mcroberts/includes/agenda-day.html.twig' with {d: ev.day} only %}</ol></section><section class="event-next" aria-labelledby="ev-next"><h2 id="ev-next">Upcoming Events</h2><ol class="agenda">{% for d in ev.next %}{% include '@mcroberts/includes/agenda-day.html.twig' with {d: d} only %}{% endfor %}</ol></section><div class="event-actions"><a class="btn btn-subscribe" href="{{ mc.chrome.webcal }}">{{ m.icon('cal-plus') }}<span>Subscribe to our calendar</span></a><a class="arrow-link" href="{{ mc.chrome.paths.calendar }}"><span>School Calendar</span>{{ m.icon('arrow') }}</a></div></article>{% include '@mcroberts/includes/rail.html.twig' with {c: mc.chrome, r: mc.rail} only %}</div></div>
{% else %}
<article{{ attributes.addClass('node', 'node--type-calendar-event') }}>{{ title_prefix }}{% if label and not page %}<h2><a href="{{ url }}" rel="bookmark">{{ label }}</a></h2>{% endif %}{{ title_suffix }}{{ content }}</article>
{% endif %}
