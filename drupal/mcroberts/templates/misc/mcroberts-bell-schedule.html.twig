{#
/**
 * @file
 * The bell schedule (theme hook mcroberts_bell_schedule): the timetable image of the Bell Schedule page as real
 * tables, word for word from data/bell-schedule.json. Today's card (rotation, code, the day's blocks), the
 * semesters with their rotation dates, one table per rotation (MON … FRI, Collaboration Days), the Collaboration
 * Days, and the original image as a file. js/bell.js marks today, the current block and the next one
 * (America/Vancouver) from #bell-data. BodyFilter puts this in place of the image and fills in the image's URL.
 *
 * Variables: bell (Calendar::bellSchedule()).
 */
#}
{% import '@mcroberts/includes/macros.html.twig' as m %}
{% set b = bell %}
<!-- custom block (block_content bell_schedule): the timetable image as real tables, from data/bell-schedule.json; js/bell.js highlights today, the current block and the next one (America/Vancouver) -->
<section class="bell" data-bell aria-labelledby="bell-title"><h2 class="bell-title" id="bell-title">{{ b.title }}</h2><div class="bell-today" data-b="card"><div class="bt-head"><p class="eyebrow{{ b.today.is_today ? '' : ' is-empty' }}" data-b="eyebrow">Today</p><time class="bt-date" data-b="date" datetime="{{ b.today.iso }}">{{ b.today.date }}</time><ul class="chips" data-b="chips">{% if b.today.rot %}<li class="chip">{{ b.today.rot }}</li>{% endif %}{% if b.today.code %}<li class="chip chip--forest">{{ b.today.code }}</li>{% endif %}</ul></div><ol class="bt-nn" data-b="nn" hidden><li class="is-now"><span class="lbl">Now</span><b></b><time></time></li><li class="is-next"><span class="lbl">Next</span><b></b><time></time></li></ol><ol class="blocks" data-b="blocks">{% for x in b.today.blocks %}<li style="--m:{{ x.m }}"{% if x.cls %} class="{{ x.cls }}"{% endif %}{% if x.blk %} data-blk="{{ x.blk }}"{% endif %}><b>{{ x.label }}</b><time>{{ x.range }}</time></li>{% endfor %}</ol></div><div class="table-wrap sem-wrap"><table class="sem-table"><thead><tr>{% for s in b.semesters %}<th scope="col">{{ s.name }}</th>{% endfor %}</tr></thead><tbody><tr>{% for s in b.semesters %}<td class="sem-dates">{{ s.dates }}</td>{% endfor %}</tr>{% for i in b.rows %}<tr>{% for s in b.semesters %}{% set r = s.rotations[i]|default(null) %}{% if r %}<td class="sem-rot{{ r.current ? ' is-current' : '' }}" data-from="{{ r.from }}" data-to="{{ r.to }}"><span class="rname">{{ r.name }}:</span> <span>{{ r.span }}</span></td>{% endif %}{% endfor %}</tr>{% endfor %}</tbody></table></div><div class="rots">{% for t in b.tables %}<section class="rot" aria-labelledby="rot-{{ t.n }}"><h3 class="rot-name" id="rot-{{ t.n }}">{{ t.name }}</h3><div class="rot-wrap" role="region" aria-labelledby="rot-{{ t.n }}"><table class="rot-table" data-rot="{{ t.name }}" aria-labelledby="rot-{{ t.n }}"><thead><tr>{% for c in t.cells %}<th scope="col" data-col="{{ c.col }}"{% if c.today %} class="is-today"{% endif %}>{% if c.today %}<span class="tag-today">Today</span>{% endif %}<span>{{ c.col }}</span></th>{% endfor %}</tr></thead><tbody><tr>{% for c in t.cells %}<td data-col="{{ c.col }}"{% if c.today %} class="is-today"{% endif %}><ol class="bday">{% for k in c.blocks %}<li class="blk blk-{{ k.kind }}" style="--r:{{ k.r }};--l:{{ k.l }}" data-from="{{ k.from }}" data-to="{{ k.to }}"><b>{{ k.label }}</b><time><span>{{ k.a }}</span><span class="dash">-</span><span>{{ k.b }}</span></time></li>{% endfor %}</ol></td>{% endfor %}</tr></tbody></table></div></section>{% endfor %}</div><div class="collab bell-collab"><h3 class="collab-title">{{ b.collab_title }}</h3><ol data-b="collab">{% for x in b.collab %}<li{% if x.cls %} class="{{ x.cls }}"{% endif %}>{% if x.past %}<s><time datetime="{{ x.iso }}">{{ x.label }}</time></s>{% else %}<time datetime="{{ x.iso }}">{{ x.label }}</time>{% endif %}</li>{% endfor %}</ol></div><p class="bell-orig">{% include '@mcroberts/includes/file-card.html.twig' with {f: {url: '__MCROBERTS_BELL_SRC__', name: b.title, ext: 'png', doc: false, size: ''}} only %}</p><script type="application/json" id="bell-data">{{ b.json }}</script></section>
